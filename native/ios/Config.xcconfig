// Where the owner publishes the privacy policy and terms (`/privacy` and `/terms` are appended)
// and how learners reach support. Both are shown in the app and left out when empty.
WHYLINT_LEGAL_URL = https:/$()/whylint-8715935974.asia-northeast1.run.app
WHYLINT_SUPPORT_CONTACT =
// Debug builds and UI tests show a reserved example address so the row is visible; Release stays
// empty until the owner sets the real contact.
WHYLINT_SUPPORT_CONTACT[config=Debug] = support@example.test

