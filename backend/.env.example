DB_URL=postgresql://{username}@127.0.0.1:{postgresql_port}/whylint
JWT_SECRET=64-character-secret. Generate it with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GOOGLE_CLIENT_ID=get this key from google cloud console
GOOGLE_CLIENT_SECRET=get this key from google cloud console
FRONTEND_URL=http://localhost:4200

GEMINI_API_KEY=

GEMINI_MODEL=
# Optional. Thinking level for Gemini 3.x models ("low" keeps quizzes fast; "default" omits it).
GEMINI_THINKING_LEVEL=low

# Optional. Number of trusted proxy hops in front of the API (Cloud Run: 1). Unset locally.
TRUST_PROXY=

# Optional. PostgreSQL TLS: off (default), verify (check the server certificate), no-verify (encrypt only).
# Any other value stops startup. With verify, trust a private CA through DB_SSL_CA (PEM text) or DB_SSL_CA_FILE (path).
DB_SSL=
DB_SSL_CA=
DB_SSL_CA_FILE=

# Optional. Directory with the built Angular app. The container image sets it to /app/public so one origin
# serves the app and the API. Leave it unset in local development, where `ng serve` serves the app.
FRONTEND_DIST=

# Optional. Set to off to skip loading the question pool at startup (the release job loads it).
LEARNING_POOL_SEED=

# Optional. Where the owner publishes the legal pages. Clients link to <base>/privacy and
# <base>/terms and show nothing while this is unset. HTTPS (or http://localhost) only.
LEGAL_BASE_URL=
# Optional. How learners reach support (an email address, URL or short text, 120 characters at most).
SUPPORT_CONTACT=

# Transactional email (email verification and password reset) through Resend.
# Required in production: without a key, production refuses to send; development writes the
# message to the server log instead. Keep the key in Secret Manager, never in source control.
RESEND_API_KEY=
# Sender on a domain verified in Resend, for example: WhyLint <noreply@whylint.com>
MAIL_FROM=
